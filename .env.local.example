# Disposable local settings for docker-compose.dev.yml and host-side pnpm.
# Copy to .env.local, then export with: set -a; source .env.local; set +a
# These known credentials are for local development only.
COMPOSE_PROJECT_NAME=cab-local
POSTGRES_PORT=54320
REDIS_PORT=63790
PORT=3000
POSTGRES_PASSWORD=cab_local_only
REDIS_PASSWORD=cab_local_only
DATABASE_URL=postgres://cab_local:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/cab_local
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:${REDIS_PORT}/0
SESSION_SECRET=local-only-disposable-session-secret-change-for-deployment
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:${PORT}
CAB_TRUSTED_PROXY_IPS=

# Keep local runs independent of any deployment analytics/logging credentials.
AXIOM_TOKEN=
AXIOM_DATASET=
POSTHOG_API_KEY=
POSTHOG_PERSONAL_API_KEY=
