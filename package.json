{
  "name": "cards-against-bhayanak",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "tsx server.prod.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/lib/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts apply",
    "db:check": "tsx scripts/migrate.ts check",
    "db:baseline": "tsx scripts/migrate.ts adopt",
    "db:signature": "tsx scripts/schema-signature.ts",
    "test:migrations": "node --test tests/deployment/migrations.test.mjs",
    "test:storage": "node --test tests/deployment/storage.test.mjs"
  },
  "dependencies": {
    "@axiomhq/pino": "^1.6.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-start": "^1.167.65",
    "crossws": "0.4.5",
    "drizzle-orm": "^0.45.2",
    "h3": "2.0.1-rc.22",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "posthog-js": "^1.373.3",
    "posthog-node": "^5.34.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "seedrandom": "^3.0.5",
    "srvx": "0.11.15",
    "tsx": "^4.21.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.19",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/seedrandom": "^3.0.8",
    "@vitest/coverage-v8": "^4.1.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "core-js",
      "protobufjs"
    ]
  }
}
